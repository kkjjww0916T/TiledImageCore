<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:TiledImage.Wpf.Mapping">

    <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

    <Style TargetType="{x:Type local:ImageMappingControl}">
        <Setter Property="Background" Value="#282828"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ImageMappingControl}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <!-- Main image display -->
                            <Image x:Name="PART_Image"
                                   Stretch="None"
                                   RenderOptions.BitmapScalingMode="NearestNeighbor"/>

                            <!-- Perspective control overlay -->
                            <Canvas x:Name="PART_PerspectiveCanvas"
                                    Visibility="{Binding IsPerspectiveMode, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
