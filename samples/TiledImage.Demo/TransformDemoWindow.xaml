<Window x:Class="TiledImage.Demo.TransformDemoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:TiledImage.Wpf.Viewer;assembly=TiledImage.Wpf.Viewer"
        xmlns:local="clr-namespace:TiledImage.Demo"
        xmlns:converters="clr-namespace:TiledImage.Demo.Converters"
        xmlns:vm="clr-namespace:TiledImage.Demo.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:TransformDemoViewModel}"
        Title="Image Transform Demo" Height="900" Width="1400"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <converters:DepthToVisibilityConverter x:Key="DepthToVisibilityConverter"/>
        <local:ZoomToPercentConverter x:Key="ZoomToPercentConverter"/>
        <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <ToolBarTray Grid.Row="0">
            <ToolBar>
                <Button Command="{Binding OpenFileCommand}" ToolTip="Open Image File">
                    <TextBlock Text="Open Image"/>
                </Button>
                <Separator/>
                <Button Command="{Binding TransformCommand}" ToolTip="Apply Transform">
                    <TextBlock Text="Transform"/>
                </Button>
                <Button Command="{Binding ExportCommand}" ToolTip="Export Transformed Image">
                    <TextBlock Text="Export"/>
                </Button>
                <Button Command="{Binding ResetOptionsCommand}" ToolTip="Reset All Options">
                    <TextBlock Text="Reset"/>
                </Button>
            </ToolBar>
        </ToolBarTray>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Transform Options Panel -->
            <Border Grid.Column="0" Background="#2D2D30" Padding="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Transform Options" FontWeight="Bold" FontSize="14"
                                   Foreground="White" Margin="0,0,0,15"/>

                        <!-- Rotation -->
                        <TextBlock Text="Rotation (degrees)" Foreground="White" Margin="0,0,0,5"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <Slider Grid.Column="0" Minimum="-180" Maximum="180"
                                    Value="{Binding RotationDegrees}"
                                    TickFrequency="15" IsSnapToTickEnabled="False"/>
                            <TextBox Grid.Column="1" Text="{Binding RotationDegrees, StringFormat=F1}"
                                     Margin="5,0,0,0" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Scale -->
                        <TextBlock Text="Scale Factor" Foreground="White" Margin="0,15,0,5"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <Slider Grid.Column="0" Minimum="0.1" Maximum="4.0"
                                    Value="{Binding ScaleFactor}"
                                    TickFrequency="0.1" IsSnapToTickEnabled="False"/>
                            <TextBox Grid.Column="1" Text="{Binding ScaleFactor, StringFormat=F2}"
                                     Margin="5,0,0,0" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Flip Options -->
                        <TextBlock Text="Flip" Foreground="White" Margin="0,15,0,5"/>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox Content="Horizontal" IsChecked="{Binding FlipHorizontal}"
                                      Foreground="White" Margin="0,0,15,0"/>
                            <CheckBox Content="Vertical" IsChecked="{Binding FlipVertical}"
                                      Foreground="White"/>
                        </StackPanel>

                        <!-- Interpolation -->
                        <TextBlock Text="Interpolation" Foreground="White" Margin="0,15,0,5"/>
                        <ComboBox SelectedIndex="{Binding SelectedInterpolation}">
                            <ComboBoxItem Content="Nearest Neighbor"/>
                            <ComboBoxItem Content="Bilinear"/>
                            <ComboBoxItem Content="Bicubic"/>
                        </ComboBox>

                        <!-- Crop Options -->
                        <Separator Margin="0,20,0,10"/>
                        <CheckBox Content="Enable Crop" IsChecked="{Binding EnableCrop}"
                                  Foreground="White" FontWeight="Bold" Margin="0,0,0,10"/>

                        <StackPanel IsEnabled="{Binding EnableCrop}">
                            <TextBlock Text="Center offset (0,0 = image center)" Foreground="#888888"
                                       FontSize="10" Margin="0,0,0,5"/>

                            <!-- Pixel-based crop inputs -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,5,5">
                                    <TextBlock Text="Offset X (px)" Foreground="White"/>
                                    <TextBox Text="{Binding CropX}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="5,0,0,5">
                                    <TextBlock Text="Offset Y (px)" Foreground="White"/>
                                    <TextBox Text="{Binding CropY}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,5,0">
                                    <TextBlock Text="Width (px)" Foreground="White"/>
                                    <TextBox Text="{Binding CropWidth}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="5,0,0,0">
                                    <TextBlock Text="Height (px)" Foreground="White"/>
                                    <TextBox Text="{Binding CropHeight}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <!-- Z Slice (if 3D) -->
                        <Separator Margin="0,20,0,10"/>
                        <StackPanel Visibility="{Binding IsZSliderEnabled, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Z Slice" Foreground="White" Margin="0,0,0,5"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>
                                <Slider Grid.Column="0" Minimum="0" Maximum="{Binding MaxZ}"
                                        Value="{Binding CurrentZ}"
                                        TickFrequency="1" IsSnapToTickEnabled="True"/>
                                <TextBlock Grid.Column="1" Foreground="White"
                                           VerticalAlignment="Center" Margin="5,0,0,0">
                                    <Run Text="{Binding CurrentZ, Mode=OneWay}"/>
                                    <Run Text=" / "/>
                                    <Run Text="{Binding MaxZ, Mode=OneWay}"/>
                                </TextBlock>
                            </Grid>
                        </StackPanel>

                        <!-- LUT Display Range -->
                        <Separator Margin="0,20,0,10"/>
                        <TextBlock Text="Display Range (LUT)" Foreground="White" FontWeight="Bold" Margin="0,0,0,10"/>

                        <TextBlock Text="Min (Black)" Foreground="White" Margin="0,0,0,3"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <Slider Grid.Column="0" Minimum="0" Maximum="{Binding DisplayRangeMax}"
                                    Value="{Binding DisplayMin}" SmallChange="1" LargeChange="100"/>
                            <TextBox Grid.Column="1" Margin="5,0,0,0"
                                     Text="{Binding DisplayMin, UpdateSourceTrigger=PropertyChanged, StringFormat=F0}"/>
                        </Grid>

                        <TextBlock Text="Max (White)" Foreground="White" Margin="0,10,0,3"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <Slider Grid.Column="0" Minimum="0" Maximum="{Binding DisplayRangeMax}"
                                    Value="{Binding DisplayMax}" SmallChange="1" LargeChange="100"/>
                            <TextBox Grid.Column="1" Margin="5,0,0,0"
                                     Text="{Binding DisplayMax, UpdateSourceTrigger=PropertyChanged, StringFormat=F0}"/>
                        </Grid>

                        <Button Content="Reset LUT" Margin="0,10,0,0" Padding="5,3"
                                Command="{Binding ResetLutCommand}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Original Image -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="#3E3E42" Padding="10,5">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Original" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="{Binding OriginalInfoText}" Foreground="#AAAAAA" Margin="15,0,0,0"/>
                    </StackPanel>
                </Border>
                <controls:ImageViewControl x:Name="OriginalViewer" Grid.Row="1"
                                           ImageSource="{Binding OriginalImageSource}"
                                           CurrentZ="{Binding CurrentZ, Mode=TwoWay}"
                                           DisplayMin="{Binding DisplayMin}"
                                           DisplayMax="{Binding DisplayMax}"/>
            </Grid>

            <!-- Transformed Image -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="#3E3E42" Padding="10,5">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Transformed" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="{Binding TransformedInfoText}" Foreground="#AAAAAA" Margin="15,0,0,0"/>
                    </StackPanel>
                </Border>
                <controls:ImageViewControl x:Name="TransformedViewer" Grid.Row="1"
                                           ImageSource="{Binding TransformedImageSource}"
                                           CurrentZ="{Binding CurrentZ, Mode=TwoWay}"
                                           DisplayMin="{Binding DisplayMin}"
                                           DisplayMax="{Binding DisplayMax}"/>

                <!-- Placeholder when no transformed image -->
                <Border Grid.Row="1" Background="#1E1E1E"
                        Visibility="{Binding TransformedImageSource, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Visible}">
                    <TextBlock Text="Click 'Transform' to see result"
                               Foreground="#666666" FontSize="14"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Grid>

        <!-- Progress Bar -->
        <ProgressBar Grid.Row="2" Height="5" Value="{Binding ProgressValue}"
                     Visibility="{Binding IsTransforming, Converter={StaticResource BoolToVisibility}}"/>

        <!-- Status Bar -->
        <StatusBar Grid.Row="3">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock>
                    <Run Text="Original Zoom: "/>
                    <Run Text="{Binding ElementName=OriginalViewer, Path=Zoom, Converter={StaticResource ZoomToPercentConverter}, Mode=OneWay}"/>
                </TextBlock>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock>
                    <Run Text="Transformed Zoom: "/>
                    <Run Text="{Binding ElementName=TransformedViewer, Path=Zoom, Converter={StaticResource ZoomToPercentConverter}, Mode=OneWay}"/>
                </TextBlock>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
